# Copia questo file in .dev.vars solo sulla macchina locale. Non inserire valori veri nel repository.
# Le password devono essere nuove, di almeno 8 caratteri, diverse tra loro.
# Non riusare negozio, admin, 1001 o 1002.
#
# Su GitHub Pages (VPN) l'accesso shop/admin usa Firebase Authentication
# come ListinoSmartphones, progetto deviceproposer. Crea in Firebase Auth:
#   preventivatore-shop@deviceproposer.invalid
#   preventivatore-admin@deviceproposer.invalid
# e in Firestore users/{uid}: { role: "seller"|"admin", active: true, app: "preventivatore" }.
# Le password stanno solo in Firebase, non in questo file né in index.html.
SELLER_PASSWORD=
ADMIN_PASSWORD=
GITHUB_TOKEN=
OFFLINE_SIGNING_JWK=
